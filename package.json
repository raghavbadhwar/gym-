{
  "name": "credity-monorepo",
  "version": "1.0.0",
  "description": "Credity Ecosystem Monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm run test:shared-auth && pnpm run test:wallet && pnpm run test:issuer && pnpm run test:recruiter && pnpm run test:gateway && pnpm run test:mobile && pnpm run test:contracts",
    "test:shared-auth": "cd packages/shared-auth && pnpm run build",
    "test:wallet": "cd BlockWalletDigi && pnpm test",
    "test:issuer": "cd \"CredVerseIssuer 3\" && pnpm test",
    "test:recruiter": "cd CredVerseRecruiter && pnpm test",
    "test:gateway": "cd credverse-gateway && pnpm test",
    "test:mobile": "cd apps/mobile && pnpm test",
    "test:contracts": "cd \"CredVerseIssuer 3/contracts\" && pnpm install && pnpm run analyze:static",
    "lint": "pnpm run lint:wallet && pnpm run lint:issuer && pnpm run lint:recruiter && pnpm run lint:gateway && pnpm run lint:shared-auth",
    "lint:wallet": "cd BlockWalletDigi && pnpm run lint",
    "lint:issuer": "cd \"CredVerseIssuer 3\" && pnpm run lint",
    "lint:recruiter": "cd CredVerseRecruiter && pnpm run lint",
    "lint:gateway": "cd credverse-gateway && pnpm run lint",
    "lint:shared-auth": "cd packages/shared-auth && pnpm run lint",
    "check": "pnpm run check:shared-auth && pnpm run check:wallet && pnpm run check:issuer && pnpm run check:recruiter",
    "check:wallet": "cd BlockWalletDigi && pnpm run check",
    "check:issuer": "cd \"CredVerseIssuer 3\" && pnpm run check",
    "check:recruiter": "cd CredVerseRecruiter && pnpm run check",
    "check:shared-auth": "cd packages/shared-auth && pnpm run build",
    "prepare": "husky",
    "mobile:dev": "cd apps/mobile && pnpm run start",
    "mobile:android": "cd apps/mobile && pnpm run android",
    "mobile:ios": "cd apps/mobile && pnpm run ios",
    "mobile:web": "cd apps/mobile && pnpm run web",
    "gate:foundation": "node scripts/foundation-e2e-gate.mjs",
    "gate:foundation:local": "node scripts/gate-foundation-local.mjs",
    "gate:launch": "node scripts/launch-gate-check.mjs",
    "gate:launch:strict": "LAUNCH_GATE_STRICT=1 node scripts/launch-gate-check.mjs",
    "smoke:infra:live": "bash scripts/infra-live-smoke.sh"
  },
  "keywords": [
    "credential",
    "blockchain",
    "verification",
    "wallet"
  ],
  "author": "Raghav Badhwar",
  "license": "UNLICENSED",
  "dependencies": {
    "ogl": "^1.0.11",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  },
  "overrides": {
    "minimatch": "^10.0.1",
    "@sentry/node": {
      "minimatch": "^10.0.1"
    }
  }
}
